<Window x:Class="Newrest.Pos.Client.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Newrest - Afficheur client" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brand}" Foreground="White" FontSize="28">
  <Grid Margin="40">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding State.Message}" FontSize="40" FontWeight="Bold" />
    <ItemsControl Grid.Row="1" ItemsSource="{Binding State.Lines}" Margin="0,24">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Mad}}" />
            <TextBlock>
              <Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Label, Mode=OneWay}" />
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="2">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State.Total, Converter={StaticResource Mad}}" /><TextBlock Text="Total" /></DockPanel>
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State.Subsidy, Converter={StaticResource Mad}}" /><TextBlock Text="Subvention employeur" /></DockPanel>
      <DockPanel><TextBlock DockPanel.Dock="Right" FontSize="48" FontWeight="Bold" Text="{Binding State.Due, Converter={StaticResource Mad}}" /><TextBlock FontSize="48" FontWeight="Bold" Text="À payer" /></DockPanel>
    </StackPanel>
  </Grid>
</Window>
