@page "/audit"
@attribute [Authorize(Roles = "Pos.Admin,Pos.Accountant")]
@inherits PageBase

<PageTitle>Journal d'audit - Newrest POS</PageTitle>
<h1>Journal d'audit</h1>
<Notice Error="@Error" />

<div class="toolbar">
    <select @bind="_entityType" @bind:after="() => GoToAsync(1)">
        <option value="">Tous les objets</option>
        @foreach (var t in EntityTypes) { <option value="@t">@t</option> }
    </select>
    <input placeholder="Utilisateur" @bind="_actor" @bind:event="oninput" @bind:after="() => GoToAsync(1)" />
    <input placeholder="Identifiant de l'objet" @bind="_entityId" @bind:after="() => GoToAsync(1)" />
</div>

<section class="card">
    <table class="audit">
        <thead><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Objet</th><th>Avant</th><th>Après</th></tr></thead>
        <tbody>
            @foreach (var a in _page.Items)
            {
                <tr>
                    <td>@Messages.DateTime(a.OccurredAt)</td><td>@a.Actor</td><td>@a.Action</td>
                    <td>@a.EntityType <code>@a.EntityId</code></td>
                    <td><code class="json">@a.BeforeJson</code></td><td><code class="json">@a.AfterJson</code></td>
                </tr>
            }
        </tbody>
    </table>
    <Pager Page="_pageNumber" PageSize="PageSize" Total="_page.TotalCount" OnChange="GoToAsync" />
</section>

@code {
    private const int PageSize = 50;
    private static readonly string[] EntityTypes =
        ["Account", "Article", "Badge", "Category", "ClientCompany", "Company", "Contract", "DailyMenu", "Diner", "Operator", "PointOfSale",
         "PriceList", "Register", "Site", "SubsidyRule", "UserAccessScope"];

    private PagedResult<AuditEntryDto> _page = new([], 0, 1, PageSize);
    private int _pageNumber = 1;
    private string? _entityType;
    private string? _actor;
    private string? _entityId;

    protected override Task LoadAsync() => GoToAsync(1);

    private async Task GoToAsync(int page)
    {
        _pageNumber = page;
        _page = await Run<AuditQueryService, PagedResult<AuditEntryDto>>(s => s.SearchAsync(_entityType, _entityId, _actor, null, null, null, page, PageSize))
                ?? _page;
    }
}
