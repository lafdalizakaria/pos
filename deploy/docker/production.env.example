# Production settings of the API and back-office containers. Copy to production.env (never commit it), or inject the
# same variables from the key vault / orchestrator secrets. Both services refuse to start if a required value is missing.
ConnectionStrings__PosDb=Server=tcp:<sql-server>,1433;Database=NewrestPos;User Id=pos_api;Password=<secret>;Encrypt=True;TrustServerCertificate=False
MIGRATOR_CONNECTION_STRING=Server=tcp:<sql-server>,1433;Database=NewrestPos;User Id=pos_migrator;Password=<secret>;Encrypt=True;TrustServerCertificate=False
Storage__RootPath=/data/storage
Security__PinHashIterations=600000
# ECDSA P-256 private key (PKCS#8 PEM, one line with \n) signing the fiscal archives; keep the public key with the archives.
Archive__SigningKeyPem=
# API
Authentication__Registers__SigningKey=
Authentication__Users__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
Authentication__Users__Audience=api://newrest-pos
Supervision__WebhookUrl=
Supervision__BackOfficeUrl=https://pos-admin.newrest.ma
# Back-office (Entra ID, confidential client)
Authentication__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
Authentication__ClientId=
Authentication__ClientSecret=
# Reverse proxy network (X-Forwarded-For / -Proto trusted only from there)
ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
