<Application x:Class="Newrest.Pos.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Newrest.Pos.Client.Infrastructure"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Views/Theme.xaml" />
        <ResourceDictionary Source="Views/Pages.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <infra:MadConverter x:Key="Mad" />
      <infra:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
      <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <infra:OnlineBrushConverter x:Key="OnlineBrush" />
      <infra:HexBrushConverter x:Key="HexBrush" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
