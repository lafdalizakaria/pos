<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows compiling (not running) the WPF client on Linux CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Newrest.Pos.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Newrest.Pos.Client.Data/Newrest.Pos.Client.Data.csproj" />
    <ProjectReference Include="../Newrest.Pos.Devices/Newrest.Pos.Devices.csproj" />
  </ItemGroup>
</Project>
