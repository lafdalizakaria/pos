<Window x:Class="Newrest.Pos.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Newrest.Pos.Client.ViewModels"
        Title="Newrest - Caisse" Height="768" Width="1024" WindowState="Maximized">
  <Window.DataContext>
    <vm:ShellViewModel />
  </Window.DataContext>
  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Status}" FontSize="20" Margin="0,16,0,0" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
