@page "/vision"
@inherits PageBase
@inject TimeProvider Clock

<PageTitle>Performance vision - Newrest POS</PageTitle>
<h1>Performance de la reconnaissance des plateaux</h1>
<Notice Error="@Error" Success="@Success" />

<div class="toolbar">
    <label>Du <input type="date" @bind="_from" /></label>
    <label>Au <input type="date" @bind="_to" /></label>
    <label>Site
        <select @bind="_siteId">
            <option value="">Tous les sites</option>
            @foreach (var s in _sites) { <option value="@s.Id">@s.Name</option> }
        </select>
    </label>
    <label>Moteur / modèle
        <input placeholder="ex. gemini, yolo:20261003" @bind="_provider" />
    </label>
    <button disabled="@Busy" @onclick="RefreshAsync">Afficher</button>
</div>

@if (_stats is { } st)
{
    <section class="card">
        <h2>Indicateurs</h2>
        <p class="hint">Auto = ajouté sans intervention (confiance ≥ seuil haut) ; Confirmé = proposé en surbrillance et gardé ;
            Corrigé = la caissière a choisi un autre article ; Manuel = article non proposé, ajouté depuis le menu.
            Taux de correction = corrigés / quantités proposées par la vision. Indisponible = délai dépassé ou service en erreur (saisie manuelle).</p>
        <table>
            <thead><tr><th></th><th class="num">Plateaux</th><th class="num">Indisponible</th><th class="num">Latence moy.</th><th class="num">Latence p95</th>
                <th class="num">Articles</th><th class="num">Auto</th><th class="num">Confirmé</th><th class="num">Corrigé</th><th class="num">Manuel</th>
                <th class="num">Taux auto</th><th class="num">Taux de correction</th></tr></thead>
            <tbody>
                @foreach (var (k, group) in Rows(st))
                {
                    <tr class="@(group == "total" ? "strong" : null)">
                        <td>@(group != "provider" ? k.Label : k.Label == "none" ? "Sans réponse (saisie manuelle)" : $"Provider {k.Label}")</td>
                        <td class="num">@k.Recognitions</td><td class="num @(k.TimedOut > 0 ? "negative" : null)">@k.TimedOut</td>
                        <td class="num">@k.AverageLatencyMs ms</td><td class="num">@k.P95LatencyMs ms</td>
                        <td class="num">@k.Lines</td><td class="num">@k.Auto</td><td class="num">@k.Confirmed</td><td class="num">@k.Corrected</td><td class="num">@k.Manual</td>
                        <td class="num">@Messages.Percent(k.AutoAcceptRate)</td><td class="num">@Messages.Percent(k.CorrectionRate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @if (st.Calibration is { } cal)
    {
        <section class="card">
            <h2>Calibration des seuils</h2>
            <p class="hint">Part des propositions gardées par les caissières (ajout automatique ou confirmé) selon la confiance annoncée par le
                moteur, sur @cal.Predictions prédiction(s) de plateaux encaissés. Filtrer sur un moteur ou un modèle (champ ci-dessus) : chaque
                moteur a sa propre échelle de confiance.</p>
            <p>
                @if (cal.SuggestedHigh is { } high)
                {
                    <strong>Seuil haut suggéré : @high.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</strong>
                    <span> (précision @Messages.Percent(cal.PrecisionAtHigh ?? 0) au-dessus)</span>
                    @if (cal.SuggestedLow is { } low)
                    {
                        <span> — <strong>seuil bas suggéré : @low.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</strong>
                            (propositions justes à @Messages.Percent(cal.PrecisionAtLow ?? 0))</span>
                    }
                    <span class="muted"> — à reporter dans <a href="vision/modeles">Modèles vision</a>.</span>
                }
                else { <span class="muted">Pas assez de données pour suggérer des seuils (30 prédictions au moins au-dessus du seuil).</span> }
            </p>
            <table>
                <thead><tr><th>Confiance</th><th class="num">Prédictions</th><th class="num">Gardées</th><th class="num">Précision</th></tr></thead>
                <tbody>
                    @foreach (var b in cal.Buckets.Where(b => b.Count > 0).Reverse())
                    {
                        <tr><td>@Messages.Percent(b.From) – @Messages.Percent(b.To)</td><td class="num">@b.Count</td><td class="num">@b.Correct</td>
                            <td class="num">@Messages.Percent(b.Precision)</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section class="card">
        <h2>Par article</h2>
        <p class="hint">Les articles les plus corrigés ou saisis à la main en premier : candidats pour de nouvelles photos de référence ou une
            meilleure description visuelle.</p>
        <table>
            <thead><tr><th>Article</th><th class="num">Vendus (plateaux reconnus)</th><th class="num">Auto</th><th class="num">Confirmé</th>
                <th class="num">Corrigé</th><th class="num">Manuel</th></tr></thead>
            <tbody>
                @foreach (var a in st.ByArticle)
                {
                    <tr><td><code>@a.ArticleCode</code> @a.ArticleName</td><td class="num">@a.Sold</td><td class="num">@a.Auto</td><td class="num">@a.Confirmed</td>
                        <td class="num @(a.Corrected > 0 ? "negative" : null)">@a.Corrected</td><td class="num">@a.Manual</td></tr>
                }
            </tbody>
        </table>
    </section>

    <section class="card">
        <h2>Confusions fréquentes</h2>
        @if (st.Confusions.Count == 0) { <p class="muted">Aucune correction sur la période.</p> }
        else
        {
            <table>
                <thead><tr><th>Proposé par le modèle</th><th>Vendu</th><th class="num">Nombre</th></tr></thead>
                <tbody>@foreach (var c in st.Confusions) { <tr><td><code>@c.Predicted</code></td><td><code>@c.Actual</code></td><td class="num">@c.Count</td></tr> }</tbody>
            </table>
        }
    </section>
}

@code {
    private IReadOnlyList<SiteDto> _sites = [];
    private VisionStatsDto? _stats;
    private DateOnly _from;
    private DateOnly _to;
    private Guid? _siteId;
    private string? _provider;

    protected override async Task LoadAsync()
    {
        _to = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        _from = _to.AddDays(-6);
        _sites = await Run<OrganizationService, IReadOnlyList<SiteDto>>(s => s.ListSitesAsync()) ?? [];
        await RefreshAsync();
    }

    private async Task RefreshAsync() =>
        _stats = await Run<RecognitionService, VisionStatsDto>(s => s.GetStatsAsync(_from, _to, _siteId, default, string.IsNullOrWhiteSpace(_provider) ? null : _provider.Trim()));

    private static IEnumerable<(VisionKpiDto Kpi, string Group)> Rows(VisionStatsDto stats) =>
        [(stats.Total, "total"), .. stats.BySite.Select(s => (s, "site")), .. stats.ByProvider.Select(p => (p, "provider"))];
}
