# Copy to .env (never commit .env). Used by deploy/docker-compose.dev.yml and local runs.

# SQL Server SA password for the local development container (min. 8 chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=

# Connection string used by Newrest.Pos.Api, Newrest.Pos.BackOffice and Newrest.Pos.Migrator.
# Example for the dev container: Server=localhost,1433;Database=NewrestPos;User Id=sa;Password=<same as above>;TrustServerCertificate=true
ConnectionStrings__PosDb=

# PBKDF2 iterations for operator PINs (600000 in production; lower only for local development).
Security__PinHashIterations=600000

# Optional OpenTelemetry collector (OTLP). Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Vision service (phase 4) - never commit a real key.
GEMINI_API_KEY=

# --- Phase 2: authentication -------------------------------------------------------------
# API: register device tokens (HMAC key, at least 32 characters, never committed).
Authentication__Registers__SigningKey=
# API: Entra ID for back-office users (app registration exposing the API, app roles Pos.Admin/Pos.Manager/Pos.Accountant/Pos.Viewer).
Authentication__Users__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
Authentication__Users__Audience=api://newrest-pos
# Back-office: Entra ID OpenID Connect (confidential client).
Authentication__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
Authentication__ClientId=
Authentication__ClientSecret=
# Back-office: development login form (Development only, refused in Production).
Authentication__DevLoginEnabled=false
# Reference photos storage root.
Storage__RootPath=
