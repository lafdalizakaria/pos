<Window x:Class="Newrest.Pos.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Newrest - Caisse" Height="800" Width="1280" WindowState="Maximized"
        Background="{StaticResource Background}" FontSize="18"
        PreviewTextInput="OnPreviewTextInput" PreviewKeyDown="OnPreviewKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="12,8">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" Text="{Binding RegisterName}" />
        <TextBlock DockPanel.Dock="Left" Foreground="#DBE4FF" Margin="24,0,0,0" VerticalAlignment="Center" Text="{Binding OperatorName}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource NavButton}" Content="Vente" Command="{Binding ShowSaleCommand}" />
          <Button Style="{StaticResource NavButton}" Content="Historique" Command="{Binding ShowHistoryCommand}" />
          <Button Style="{StaticResource NavButton}" Content="Recharge / solde" Command="{Binding ShowTopUpCommand}" />
          <Button Style="{StaticResource NavButton}" Content="Clôture" Command="{Binding ShowCloseCommand}" />
          <Button Style="{StaticResource NavButton}" Content="Responsable" Command="{Binding ShowSupervisorCommand}" />
          <Button Style="{StaticResource NavButton}" Content="Synchroniser" Command="{Binding SyncNowCommand}" />
          <Button Style="{StaticResource NavButton}" Content="Déconnexion" Command="{Binding LogoutCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Permanent status: online / offline / items waiting to be sent. -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{Binding Status.IsOnline, Converter={StaticResource OnlineBrush}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Foreground="White" Text="{Binding Status.VisionLabel}" />
        <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Status.Label}" />
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding CurrentPage}" Margin="12" />
  </DockPanel>
</Window>
